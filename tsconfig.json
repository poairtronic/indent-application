{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "declaration": false,
    "outDir": "./dist-scripts",
    "rootDir": "."
  },
  "include": ["scripts/**/*", "tools/**/*"],
  "exclude": ["node_modules", "backend", "frontend", "database"]
}
