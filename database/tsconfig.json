{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "typeRoots": [
      "../backend/node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["../backend/node_modules/@prisma/client"],
      "*": ["../backend/node_modules/*"]
    }
  },
  "include": ["**/*.ts"]
}
